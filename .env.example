# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_URL=postgresql://postgres:postgres@localhost:5432/fraud_detection

# ============================================================================
# MLFLOW CONFIGURATION
# ============================================================================
MLFLOW_TRACKING_URI=http://10.107.101.128:5000
MLFLOW_MODEL_NAME=fraud_detection_model
MLFLOW_MODEL_ALIAS=production
MLFLOW_EXPERIMENT_NAME=fraud-detection
MLFLOW_TAGS={"project":"realtime-pipeline","owner":"admin"}

# ============================================================================
# KAFKA CONFIGURATION
# ============================================================================
BOOTSTRAP_SERVERS=10.107.101.128:9092
TOPIC_RAW=transactions_raw
TOPIC_PROCESSED=transactions_processed

# ============================================================================
# MODEL DIRECTORIES
# ============================================================================
MODEL_DIR_TRAIN=models
MODEL_DIR_USE=models/fraud_detection_latest
ARTIFACTS_DIR_TRAIN=artifacts
ARTIFACTS_DIR_USE=artifacts/latest

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60

# ============================================================================
# API CONFIGURATION
# ============================================================================
PORT=8000

# ============================================================================
# ML TRAINING CONFIGURATION
# ============================================================================
BATCH_LOOKBACK_MINUTES=15
BATCH_INTERVAL_SECONDS=900
RETRAIN_EVERY_N_BATCHES=1
FPR_CAP=0.05
RECALL_TGT=0.90
TEST_RATIO=0.2
WINDOW_MONTHS=1
LIMIT_NONFRAUD=0
USE_FRAUD_TABLE=false

# ============================================================================
# DATA GENERATION (rt_producer.py)
# ============================================================================
INTERVAL_SEC=2
START_SEQ=1
SIMULATION_MODE=auto
HISTORICAL_DAYS=0
GENERATE_WITH_SCORES=false
USE_ML_SCORING=true
SCORE_MIN=0
SCORE_MAX=100

# ============================================================================
# DATA PATHS (Optional - for custom data files)
# ============================================================================
# NONFRAUD_CSV_NAME_USE=data/transactions.csv
# FRAUD_CSV_NAME_USE=data/is_fraud.csv
# HOLDOUT_SAVE_NAME=artifacts/holdout.csv
# NONFRAUD_CSV_NAME_OUT=data/transaction.csv
# FRAUD_CSV_NAME_OUT=data/is_fraud.csv
# FRAUD_SEQS_CSV=data/fraud_seqs.csv

# ============================================================================
# AZURE CONFIGURATION (Optional - for cloud deployment)
# ============================================================================
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=










