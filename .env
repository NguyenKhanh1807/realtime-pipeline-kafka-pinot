# PostgreSQL Database Configuration
DB_URL=postgresql://postgres:postgres@localhost:5432/fraud_detection

# Model directories
MODEL_DIR_TRAIN=models
ARTIFACTS_DIR_TRAIN=artifacts
MODEL_DIR_USE=models/current
ARTIFACTS_DIR_USE=artifacts/current

# Server configuration
PORT=8080
BATCH_LOOKBACK_MINUTES=999

# Model parameters
FPR_CAP=0.01
RECALL_TGT=0.80
TEST_RATIO=0.20

# MLflow configuration
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_MODEL_NAME=KTDL-fraud-ydf
MLFLOW_MODEL_ALIAS=Production
MLFLOW_EXPERIMENT_NAME=KTDL-fraud-detection
MLFLOW_TAGS={"project":"fraud_service","owner":"admin"}

# JWT Authentication
JWT_SECRET_KEY=vincent
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=11520

# Batch processing
BATCH_INTERVAL_SECONDS=900
RETRAIN_EVERY_N_BATCHES=672

# Training configuration
WINDOW_MONTHS=6
LIMIT_NONFRAUD=30000
USE_FRAUD_TABLE=False

# Data paths
NONFRAUD_CSV_NAME_USE=data/transactions.csv
FRAUD_CSV_NAME_USE=data/is_fraud.csv
HOLDOUT_SAVE_NAME=artifacts/holdout.csv
NONFRAUD_CSV_NAME_OUT=data/transaction.csv
FRAUD_CSV_NAME_OUT=data/is_fraud.csv
FRAUD_SEQS_CSV=data/fraud_seqs.csv
